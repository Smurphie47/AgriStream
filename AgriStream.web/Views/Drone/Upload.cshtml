@model AgriStream.web.Models.DroneUploadViewModel

@{
    ViewData["Title"] = "Drone Image Upload";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <h1 class="text-success">Drone Image Upload</h1>

        <p class="text-muted">
            Upload farm imagery to Azure Blob Storage.
        </p>

        @if (TempData["Success"] is string message)
        {
            <div class="alert alert-success" role="status">
                @message
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-controller="Drone"
                      asp-action="Upload"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Image"
                               class="form-label"></label>

                        <input asp-for="Image"
                               type="file"
                               accept=".jpg,.jpeg,.png"
                               class="form-control" />

                        <span asp-validation-for="Image"
                              class="text-danger"></span>

                        <div class="form-text">
                            JPG or PNG. Maximum file size: 20 MB.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Upload image
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}