@{
    ViewData["Title"] = "Telemetry Simulator";
}

<div class="mt-4">
    <h1 class="text-success">Telemetry Simulator</h1>

    <p class="text-muted">
        Generate sample readings for the North, South and East fields.
        These are simulated values, not live sensor measurements.
    </p>

    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success" role="status">
            @message
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5">Generate sensor data</h2>

            <p>
                Each click stores one reading per device, including
                soil moisture, temperature, humidity and recording time.
            </p>

            <form asp-controller="Telemetry"
                  asp-action="Generate"
                  method="post">
                <button type="submit" class="btn btn-success">
                    Generate 3 Readings
                </button>
            </form>
        </div>
    </div>
</div>